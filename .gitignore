__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ── 运行产物 / 日志 ─────────────────────────────────────
*.log
backend_run.log
backend_err.log
*.zip

# ── AI 工作记忆（含本机隐私，不上传）────────────────────
