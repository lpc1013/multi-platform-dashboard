# 一键签到运行结果（含手机号/账号名）
last_checkin*.json
# MiniMax 续期缓存与 refresh_token 轮换备份（含真实令牌）
.minimax_token.json
*_token.json
*rt_backup.json
credentials.json
.env
.env.*

