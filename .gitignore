proxy_usage.json
# 凭据备份输出
backups/

# Token 面板运行时 dump（含工作空间/会话名等使用数据，不入库）
src/_dump.json
src/_dump.err
# UI 验证截图（人工检查用，不入库）
outputs/

# 一次性迁移 / 探针脚本（含真实账号标识，仅本机使用，不入库）
tests/_*.py

